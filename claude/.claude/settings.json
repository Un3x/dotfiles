{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "env": {
    "DISABLE_SPRING": "1"
  },
  "permissions": {
    "deny": [
      "Bash(ansible-vault decrypt:*)",
      "Bash(ansible-vault edit:*)",
      "Bash(ansible-vault view:*)",
      "Bash(bin/rails credentials:*)",
      "Bash(bundle exec rails credentials:*)",
      "Bash(rails credentials:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(ssh:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/config/credentials/*.key)",
      "Read(**/config/master.key)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/unex/.local/bin/claude-usage --refresh >/dev/null 2>&1"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/unex/.claude/hooks/project-lead.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/unex/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "date '+Current date/time: %A %Y-%m-%d %H:%M %Z'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/unex/.claude/hooks/guardrails.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "playwright-skill@playwright-skill": true,
    "dsfr@dsfr-skill": false,
    "ruby-lsp@claude-plugins-official": true,
    "accessibility@rgaa-toolkit": true,
    "dsfr-skill@dsfr-skill": true
  },
  "extraKnownMarketplaces": {
    "rgaa-toolkit": {
      "source": {
        "source": "git",
        "url": "https://github.com/Isalafont/claude-skill-rgaa-dev.git"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "verbose": false,
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true
}
